{
  "name": "ceo-cockpit",
  "version": "1.0.0",
  "description": "CEO 经营驾驶舱 + 公司沙盘 + 后端控制台（React 前端 + Express/node:sqlite 后端，同仓一体化）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --no-warnings server/index.js",
    "start": "node --no-warnings server/index.js",
    "start:prod": "npm run build && node --no-warnings server/index.js",
    "test:api": "node server/tests/api-test.mjs",
    "db:check": "node --no-warnings server/scripts/db-check.mjs",
    "db:reset": "node --no-warnings server/scripts/db-reset.mjs",
    "prepare:deploy": "node --no-warnings server/scripts/prepare-deploy.mjs",
    "push:github": "node --no-warnings server/scripts/push-github.mjs",
    "push:github:pages": "node --no-warnings server/scripts/push-github.mjs --pages"
  },
  "keywords": [
    "dashboard",
    "ceo",
    "sandbox",
    "rbac",
    "admin-console",
    "express",
    "sqlite",
    "react",
    "vite"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
