# ============================================================
# 运行配置示例 —— 复制为 .env 后按需修改（.env 已加入 .gitignore）
# 不设置任何变量时，以下默认值即可直接运行
# ============================================================

# ---------- 后端服务 ----------
# 监听端口与地址（默认 8787 / 0.0.0.0）
PORT=8787
HOST=0.0.0.0

# ---------- 前端静态托管 ----------
# 后端同源托管的前端构建产物目录；留空则依次回退 dist-site → dist。
# 设置后可作为独立部署的静态资源根目录（例如 /var/www/ceo-cockpit）
# CEO_WEB_ROOT=./dist-site

# ---------- 数据存储 ----------
# SQLite 数据目录与文件名（默认 server/data/cockpit.db，目录不存在会自动创建）
# CEO_DATA_DIR=./server/data
# CEO_DB_FILE=./server/data/cockpit.db

# ---------- 安全 ----------
# JWT 签名密钥：生产环境必须替换为强随机值，否则重启/换机后令牌校验失败
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CEO_JWT_SECRET=ceo-cockpit-dev-secret-change-me

# ---------- 前端开发代理（仅 npm run dev 使用） ----------
# 开发态把浏览器发往 /api 的请求代理到此后端地址
CEO_API_TARGET=http://127.0.0.1:8787
